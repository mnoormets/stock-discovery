{
  "capturedAt": "2026-09-18T11:38:48.037Z",
  "source": "Neon golden source; read-only transaction; no external refresh",
  "queries": {
    "outcomes": "SELECT o.id,d.ticker,d.run_id,r.model_version,r.run_at,d.decision_price::float8,o.horizon,o.target_at,o.status,o.return_percent::float8,o.benchmark_status,o.benchmark_return_percent::float8,o.excess_return_percent::float8,o.observed_at,p.source,p.market_at,p.matches, b.market_at AS benchmark_market_at,b.matches AS benchmark_matches\nFROM candidate_outcomes o JOIN discovery_decisions d ON d.id=o.decision_id JOIN discovery_runs r ON r.id=d.run_id\nLEFT JOIN LATERAL (SELECT source,market_at,count(*) OVER ()::int matches FROM price_snapshots WHERE company_id=d.company_id AND captured_at >= date_trunc('milliseconds',o.observed_at) AND captured_at < date_trunc('milliseconds',o.observed_at)+interval '1 millisecond' AND price=o.observed_price ORDER BY id LIMIT 1) p ON true\nLEFT JOIN LATERAL (SELECT ps.market_at,count(*) OVER ()::int matches FROM price_snapshots ps JOIN companies c ON c.id=ps.company_id WHERE c.ticker=o.benchmark_symbol AND ps.captured_at >= date_trunc('milliseconds',o.benchmark_end_at) AND ps.captured_at < date_trunc('milliseconds',o.benchmark_end_at)+interval '1 millisecond' AND ps.price=o.benchmark_price_end ORDER BY ps.id LIMIT 1) b ON true\nWHERE r.run_type='rklb_daily' AND r.model_version='rklb-discovery-v4' AND o.horizon='1w' ORDER BY r.run_at,d.ticker",
    "concentration": "SELECT p.strategy_key,p.signal_ticker,count(*)::int buys,sum(p.gross_usd)::float8 gross_usd,sum(p.fee_usd)::float8 fee_usd FROM paper_strategy_orders p JOIN discovery_runs r ON r.id=p.run_id WHERE r.model_version='rklb-discovery-v4' AND p.book_key='strategy' AND p.status='filled' AND p.side='buy' GROUP BY 1,2 ORDER BY 1,3 DESC,2",
    "status": "SELECT r.model_version,p.strategy_key,p.book_key,p.status,count(*)::int orders,count(distinct p.signal_ticker)::int tickers FROM paper_strategy_orders p JOIN discovery_runs r ON r.id=p.run_id GROUP BY 1,2,3,4 ORDER BY 1,2,3,4"
  },
