# Kopeeri see fail nimega ".env" ja täida väärtused.
# .env on .gitignore's — võti EI satu kunagi Giti.

# Andmebaasi ühendus (docker-compose seab selle juba ise; jäta muutmata kui kasutad Dockerit)
DATABASE_URL=postgres://discovery:discovery@db:5432/discovery

# Ajavöönd cronile
TZ=Europe/Tallinn

# Financial Modeling Prep API võti (tasuta, 250 päringut/päev).
# Saad selle: https://site.financialmodelingprep.com → Dashboard → API Keys.
# Kasutatakse Yahoo varuvariandina hinna/turukapi jaoks.
FMP_API_KEY=pane_oma_voti_siia
