# Kopeeri see fail nimega ".env" ja täida väärtused.
# .env on .gitignore'is – võti ei satu Giti.

# Golden-source ühendus. Rakendus keeldub käivitumast, kui target ja host ei sobi.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
DATABASE_TARGET=golden

# Tahtlikuks lokaalseks app-käivituseks kasuta mõlemat koos:
# DATABASE_URL=postgres://discovery:discovery@localhost:5433/discovery
# DATABASE_TARGET=local

# Ajavöönd ajastajale
TZ=Europe/Tallinn

# Kaitseb /api/collect endpointi. Kasuta pikka juhuslikku väärtust.
CRON_SECRET=asenda_pika_juhusliku_saladusega

# SEC nõuab tuvastatavat User-Agenti. Kasuta oma rakenduse nime ja kontaktmeili.
SEC_USER_AGENT=stock-discovery/1.0 contact@example.com

# Financial Modeling Prep API võti (valikuline; limiidid sõltuvad paketist).
# Kasutatakse Yahoo varuvariandina hinna ja turukapitalisatsiooni jaoks.
FMP_API_KEY=pane_oma_voti_siia

# Valikuline Healthchecks.io dead-man-switch URL collect:daily jaoks.
# Lisa see lokaalsesse .env faili ja GitHub Actionsi samanimelise secret'ina.
HEALTHCHECKS_PING_URL=
